{
  "name": "@inova-lab-ws/ui",
  "version": "0.6.4",
  "description": "INOVA Lab UI: os componentes, tokens e logos da INOVA Lab Library em React. Fonte única para AmbientAI, Gate e todo produto novo do INOVA Lab.",
  "type": "module",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/INOVA-Lab-WS/inova-ui.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./variants": {
      "types": "./dist/variants.d.ts",
      "import": "./dist/variants.js"
    },
    "./theme.css": "./dist/theme.css",
    "./tokens.json": "./tokens/tokens.json"
  },
  "files": [
    "dist",
    "tokens"
  ],
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "build": "npm run tokens && tsup && cp src/styles/theme.css dist/theme.css",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run build"
  },
  "peerDependencies": {
    "lucide-react": ">=1",
    "react": ">=19",
    "react-dom": ">=19",
    "tailwindcss": ">=4"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tooltip": "^1.2.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.5.4",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@figma/code-connect": "^1.2.0",
    "@tailwindcss/cli": "^4.3.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "lucide-react": "^1.52.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0"
  }
}
