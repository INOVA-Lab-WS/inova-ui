    "$description": "Figma collection 'motion'. Durations in ms; easings as CSS timing functions.",
    "duration": {
      "fast": 150,
      "exit": 200,
      "base": 250,
      "slow": 500,
      "image": 700,
      "sweep": 2800,
      "toast-visible": 2600
